{
  "name": "code-race",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write src scripts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "demo:gif": "node scripts/demo-gif.ts",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "og": "node scripts/og-image.ts"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gifenc": "^1.0.3",
    "oxlint": "^1.81.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@10.20.0"
